  "tokenColors": [
    {
      "name": "Comments",
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#748374",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Variables",
      "scope": [
        "variable",
        "variable.other",
        "identifier",
        "meta.definition.variable"
      ],
      "settings": {
        "foreground": "#393a34"
      }
    },
    {
      "name": "Parameters",
      "scope": [
        "variable.parameter",
        "meta.parameter variable.other.readwrite"
      ],
      "settings": {
        "foreground": "#725d99"
      }
    },
    {
      "name": "Language variables (this, self, super)",
      "scope": [
        "variable.language"
      ],
      "settings": {
        "foreground": "#a75e7c",
        "fontStyle": "italic"
      }
    },
    {
      "name": "Properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "meta.object-literal.key",
        "support.type.property-name",
        "meta.property-name",
        "variable.other.member",
        "constant.other.table-name",
        "constant.other.database-name"
      ],
      "settings": {
        "foreground": "#393a34"
      }
    },
    {
      "name": "Template and embedded expressions",
      "scope": [
        "meta.template.expression",
        "meta.embedded"
      ],
      "settings": {
        "foreground": "#393a34"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "keyword.operator.logical.python",
        "keyword.other",
        "punctuation.definition.template-expression"
      ],
      "settings": {
        "foreground": "#1e754f"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "keyword.operator.assignment",
        "storage.type.function.arrow"
      ],
      "settings": {
        "foreground": "#706f68"
      }
    },
    {
      "name": "Punctuation",
      "scope": [
        "punctuation",
        "meta.brace",
        "delimiter",
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.accessor",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#706f68"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.template",
        "attribute.value"
      ],
      "settings": {
        "foreground": "#946a2b"
      }
    },
    {
      "name": "String quotes (dimmed, as in Vitesse)",
      "scope": [
        "punctuation.definition.string",
        "punctuation.definition.string.begin",
        "punctuation.definition.string.end"
      ],
      "settings": {
        "foreground": "#946a2b99"
      }
    },
    {
      "name": "String escapes",
      "scope": [
        "constant.character.escape",
        "constant.other.placeholder"
      ],
      "settings": {
        "foreground": "#a75e7c"
      }
    },
    {
      "name": "Regex",
      "scope": [
        "string.regexp",
        "source.regexp"
      ],
      "settings": {
        "foreground": "#3d808c"
      }
    },
    {
      "name": "Regex operators",
      "scope": [
        "keyword.operator.quantifier.regexp",
        "keyword.control.anchor.regexp",
        "constant.other.character-class.regexp",
        "punctuation.definition.group.regexp"
      ],
      "settings": {
        "foreground": "#725d99"
      }
    },
    {
      "name": "Numbers and constants",
      "scope": [
        "constant.numeric",
        "constant",
        "entity.name.constant",
        "support.constant",
        "variable.other.enummember",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#946a2b"
      }
    },
    {
      "name": "Booleans, null, undefined",
      "scope": [
        "constant.language"
      ],
      "settings": {
        "foreground": "#a75e7c"
      }
    },
    {
      "name": "Functions",
      "scope": [
        "entity.name.function",
        "meta.function-call entity.name.function",
        "support.function",
        "variable.function",
        "meta.function-call.generic",
        "entity.name.function.decorator"
      ],
      "settings": {
        "foreground": "#a75e7c"
      }
    },
    {
      "name": "Types and classes",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "support.type.primitive",
        "support.type.builtin",
        "storage.type.java",
        "storage.type.primitive",
        "storage.type.built-in",
        "storage.type.cs",
        "keyword.type.cs",
        "storage.type.numeric.go",
        "storage.type.string.go",
        "storage.type.boolean.go",
        "storage.type.byte.go",
        "storage.type.rune.go",
        "storage.type.error.go",
        "storage.type.uintptr.go",
        "entity.name.type.interface",
        "entity.name.struct"
      ],
      "settings": {
        "foreground": "#3d808c"
      }
    },
    {
      "name": "Namespaces and modules (plain)",
      "scope": [
        "entity.name.namespace",
        "entity.name.module",
        "entity.name.package",
        "namespace",
        "meta.module-reference",
        "entity.name.type.module",
        "entity.name.type.namespace"
      ],
      "settings": {
        "foreground": "#393a34"
      }
    },
    {
      "name": "Decorators and annotations",
      "scope": [
        "meta.decorator",
        "punctuation.decorator",
        "storage.type.annotation",
        "entity.name.function.macro",
        "meta.attribute.rust"
      ],
      "settings": {
        "foreground": "#725d99"
      }
    },
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "tag.html",
        "support.class.component"
      ],
      "settings": {
        "foreground": "#3d808c"
      }
    },
    {
      "name": "Attributes",
      "scope": [
        "entity.other.attribute-name",
        "attribute.name",
        "meta.directive.vue"
      ],
      "settings": {
        "foreground": "#725d99",
        "fontStyle": "italic"
      }
    },
    {
      "name": "CSS properties",
      "scope": [
        "support.type.property-name.css",
        "meta.property-name.css",
        "support.type.property-name.scss",
        "meta.property-name.scss",
        "support.type.property-name.less"
      ],
      "settings": {
        "foreground": "#3d808c"
      }
    },
    {
      "name": "Keys in data files",
      "scope": [
        "support.type.property-name.json",
        "support.type.property-name.toml",
        "entity.name.tag.yaml",
        "support.type.property-name.table.toml",
        "entity.other.attribute-name.table.toml",
        "keyword.other.definition.ini"
      ],
      "settings": {
        "foreground": "#3d808c",
        "fontStyle": ""
      }
    },
    {
      "name": "Section headers in config files",
      "scope": [
        "entity.name.section.group-title.ini"
      ],
      "settings": {
        "foreground": "#1e754f",
        "fontStyle": "bold"
      }
    },
    {
